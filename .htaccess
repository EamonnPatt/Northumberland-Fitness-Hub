# This repo is cloned directly into the live document root (cPanel Git
# Version Control on this host can't clone outside public_html), so
# the raw source sits alongside the deployed site (index.html, assets/,
# contact.php, etc., which are also committed at the repo root).
# Deny direct access to the source tree; everything else is real site
# content and is served normally below.
RewriteEngine On

RewriteRule ^(package(-lock)?\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|tsconfig(\.base)?\.json|replit\.md|\.replit.*|\.npmrc|\.gitignore|\.gitattributes|\.htaccess)$ - [F,L]
RewriteRule ^(lib|scripts|attached_assets|artifacts|node_modules|\.git)(/.*)?$ - [F,L]

# Serve real files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to the SPA entry point.
RewriteRule ^ index.html [L]

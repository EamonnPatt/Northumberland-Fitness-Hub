# MongoDB connection string (Atlas or otherwise)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/northumberland-fitness

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API.
# Include both the live site and localhost while developing.
CLIENT_ORIGIN=https://northumberlandfitness.com,http://localhost:5000

# Port the API listens on (most hosts set this for you automatically).
PORT=4000

# Bootstraps a single admin account on first startup. Safe to leave set
# permanently: if the account already exists, only its role is ensured to
# be "admin" — the password is never overwritten after creation.
ADMIN_EMAIL=owner@northumberlandfitness.com
ADMIN_PASSWORD=change-me-strong-password
